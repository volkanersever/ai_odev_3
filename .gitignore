# Byte-compiled / optimised / packaged python files
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
build/
dist/

# Virtual environments
.venv/
venv/
env/

# IDE / editor
.idea/
.vscode/
*.swp
*.swo
.DS_Store
.claude/

# Generated data -- regenerated by running the ingestion + build scripts
data/raw/people/*
data/raw/places/*
!data/raw/people/.gitkeep
!data/raw/places/.gitkeep
data/index/people/*
data/index/places/*
!data/index/people/.gitkeep
!data/index/places/.gitkeep
data/db/*.sqlite
data/db/*.sqlite-journal

# Local override / experiment notebooks
*.ipynb
.ipynb_checkpoints/

# Streamlit
.streamlit/secrets.toml
