# Byte-compiled / optimised / packaged python files
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
build/
dist/

# Virtual environments
.venv/
venv/
env/

# IDE / editor
.idea/
.vscode/
*.swp
*.swo
.DS_Store
.claude/

# Pre-built data ships in the repository so the instructor can skip the
# ingest + build steps.  Wikipedia content is CC BY-SA 3.0; binary
# vector files (~15 MB) are well under GitHub's per-file limit.
# To regenerate from scratch, delete these directories and re-run
# `python -m scripts.ingest && python -m scripts.build_index --reset`.
#
# data/raw/people/*
# data/raw/places/*
# data/index/people/*
# data/index/places/*
# data/db/*.sqlite
data/db/*.sqlite-journal

# Local override / experiment notebooks
*.ipynb
.ipynb_checkpoints/

# Streamlit
.streamlit/secrets.toml
